{
  "name":        "axil-examples",
  "version":     "1.0.0",
  "description": "AxilJS examples — all phases",
  "scripts": {
    "dev":       "node ../packages/cli/dist/cli.js run",
    "dev:mvc":   "npx nodemon --watch src/mvc --ext ts --exec \"npx ts-node src/mvc/main.ts\"",
    "dev:mono":  "npx nodemon --watch src/monolith --ext ts --exec \"npx ts-node src/monolith/main.ts\"",
    "build":     "tsc",
    "start":     "node dist/server.js",
    "test":      "node ../packages/cli/dist/cli.js test"
  },
  "dependencies": {
    "@axiljs/ai":            "0.1.0",
    "@axiljs/auth":          "0.1.0",
    "@axiljs/circuit":       "0.1.0",
    "@axiljs/common":        "0.1.0",
    "@axiljs/config":        "0.1.0",
    "@axiljs/core":          "0.1.0",
    "@axiljs/events":        "0.1.0",
    "@axiljs/observability": "0.1.0",
    "@axiljs/orm":           "0.1.0",
    "@axiljs/queue":         "0.1.0",
    "@axiljs/security":      "0.1.0",
    "@axiljs/validation":    "0.1.0",
    "@axiljs/websocket":     "0.1.0",
    "@axiljs/cloud":         "0.1.0",
    "@axiljs/memory":        "0.1.0"
  },
  "devDependencies": {
    "@axiljs/cli":   "0.1.0",
    "@types/node": "^20.0.0",
    "typescript":  "^5.4.0",
    "ts-node":     "^10.9.0",
    "nodemon":     "^3.1.0"
  }
}