{
  "name": "axil-examples",
  "version": "0.2.2",
  "description": "AxilJS examples — all phases",
  "scripts": {
    "dev": "npx tsx watch src/server.ts",
    "dev:mvc": "npx tsx watch src/mvc/main.ts",
    "dev:mono": "npx tsx watch src/monolith/main.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@axiljs/ai":            "*",
    "@axiljs/auth":          "*",
    "@axiljs/circuit":       "*",
    "@axiljs/cloud":         "*",
    "@axiljs/common":        "*",
    "@axiljs/config":        "*",
    "@axiljs/core":          "*",
    "@axiljs/events":        "*",
    "@axiljs/memory":        "*",
    "@axiljs/observability": "*",
    "@axiljs/orm":           "*",
    "@axiljs/queue":         "*",
    "@axiljs/security":      "*",
    "@axiljs/validation":    "*",
    "@axiljs/websocket":     "*"
  },
  "devDependencies": {
    "@axiljs/cli":    "*",
    "@types/node":    "^26.2.0",
    "nodemon":        "^3.1.14",
    "ts-node":        "^10.9.2",
    "tsx":            "^4.23.12",
    "typescript":     "^7.0.2"
  }
}