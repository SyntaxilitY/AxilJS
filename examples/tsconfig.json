{
  "compilerOptions": {
    "target":                  "ES2022",
    "module":                  "commonjs",
    "moduleResolution":        "node",
    "lib":                     ["ES2022"],
    "types":                   ["node"],
    "strict":                  true,
    "esModuleInterop":         true,
    "skipLibCheck":            true,
    "rootDir":                 "./src",
    "outDir":                  "./dist",
    "incremental":             true,
    "tsBuildInfoFile":         "./dist/.tsbuildinfo",
    "experimentalDecorators":  true,
    "emitDecoratorMetadata":   false
  },
  "include":  ["src/**/*"],
  "exclude":  ["dist", "node_modules"]
}