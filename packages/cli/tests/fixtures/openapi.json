{
  "openapi": "3.1.0",
  "info": { "title": "Shop API", "version": "1.2.0" },
  "servers": [{ "url": "http://localhost:3000/api/" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "parameters": {
      "ProductId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Product id" }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "required": ["status", "code", "message"],
        "properties": {
          "status": { "type": "integer" },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "data": {}
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
          }
        }
      },
      "ProductStatus": { "type": "string", "enum": ["draft", "active", "archived"] },
      "Product": {
        "type": "object",
        "description": "A product for sale.",
        "required": ["id", "name", "price", "status"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string", "description": "Display name" },
          "price": { "type": "number" },
          "status": { "$ref": "#/components/schemas/ProductStatus" },
          "description": { "type": ["string", "null"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "attributes": { "type": "object", "additionalProperties": { "type": "string" } },
          "content-type": { "type": "string" },
          "legacyCode": { "type": "string", "nullable": true, "deprecated": true }
        }
      },
      "NewProduct": {
        "type": "object",
        "required": ["name", "price"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "price": { "type": "number" },
          "status": { "$ref": "#/components/schemas/ProductStatus" }
        }
      },
      "ProductEnvelope": {
        "allOf": [
          { "$ref": "#/components/schemas/Envelope" },
          { "type": "object", "required": ["data"], "properties": { "data": { "$ref": "#/components/schemas/Product" } } }
        ]
      },
      "ProductList": {
        "allOf": [
          { "$ref": "#/components/schemas/Envelope" },
          {
            "type": "object",
            "properties": {
              "data": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } }
            }
          }
        ]
      },
      "Payment": {
        "oneOf": [
          { "type": "object", "required": ["kind", "card"], "properties": { "kind": { "const": "card" }, "card": { "type": "string" } } },
          { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "cash" } } }
        ]
      },
      "Tree": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value": { "type": "string" },
          "children": { "type": "array", "items": { "$ref": "#/components/schemas/Tree" } }
        }
      },
      "Point": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "items": false },
      "Anything": {}
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": { "200": { "description": "OK", "content": { "text/plain": { "schema": { "type": "string" } } } } }
      }
    },
    "/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "List products",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/ProductStatus" } },
          { "name": "tag", "in": "query", "schema": { "type": "array", "items": { "type": "string" } } }
        ],
        "responses": {
          "200": { "description": "Products", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductList" } } } }
        }
      },
      "post": {
        "operationId": "createProduct",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewProduct" } } }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductEnvelope" } } } },
          "422": { "description": "Invalid", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/products/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/ProductId" }],
      "get": {
        "operationId": "getProduct",
        "responses": {
          "200": { "description": "One product", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductEnvelope" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "patch": {
        "operationId": "update-product",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "X-Request-Id", "in": "header", "required": false, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "price": { "type": ["number", "null"] },
                  "status": { "$ref": "#/components/schemas/ProductStatus" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductEnvelope" } } } }
        }
      },
      "delete": {
        "operationId": "deleteProduct",
        "security": [{ "bearerAuth": [] }],
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/orders/{orderId}/pay": {
      "post": {
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Payment" } } } },
        "responses": {
          "200": {
            "description": "Paid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["paid"],
                  "properties": {
                    "paid": { "type": "boolean" },
                    "receipt": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
                    "point": { "$ref": "#/components/schemas/Point" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
