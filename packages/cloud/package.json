{
  "name": "@axiljs/cloud",
  "version": "0.3.1",
  "description": "AxilJS enterprise — multi-tenancy, audit logs, feature flags, deployment",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --ext .ts",
    "clean": "rimraf dist coverage deploy"
  },
  "keywords": [
    "axiljs",
    "backend",
    "javascript",
    "typescript",
    "nodejs"
  ],
  "author": "Tariq Mehmood <tariq@syntaxility.dev>",
  "license": "MIT",
  "peerDependencies": {
    "@axiljs/common": "^0.3.1",
    "@axiljs/events": "^0.3.1"
  },
  "devDependencies": {
    "@axiljs/common": "^0.3.1",
    "@axiljs/events": "^0.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SyntaxilitY/AxilJS.git"
  },
  "homepage": "https://github.com/SyntaxilitY/AxilJS#readme",
  "bugs": {
    "url": "https://github.com/SyntaxilitY/AxilJS/issues"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
